# ---- branding ----
BRAND_NAME=flip
TOKEN_TICKER=FLIP
# Mint of your pump.fun token. Turns on holder rewards and creator-fee sweeps.
TOKEN_MINT=

# ---- network ----
# Use a paid RPC (Helius, Triton, QuickNode). The public endpoint will rate-limit you.
RPC_URL=https://api.mainnet-beta.solana.com
PORT=8787
DB_PATH=./data/flip.db
CORS_ORIGIN=*
STATIC_DIR=../web/dist

# ---- money ----
# Leave false until you've run Practice on mainnet prices and passed the go-live checklist.
REAL_ENABLED=false
# Paths to keypair files from `npm run keygen` (or base58 secrets). Never commit these.
VAULT_SECRET=./keys/vault.json
CREATOR_SECRET=./keys/creator.json
# Wallets to exclude from holder rewards (team, treasury, CEX), comma separated.
HOLDER_EXCLUSIONS=
# Solana wallet whose SOL transfers to the vault go 100% to holders (claimed Hyperliquid builder fees).
HOLDER_FUND_WALLET=
ADMIN_KEY=change-me-to-a-long-random-string

# ---- risk limits ----
MAX_SIDE_SOL=5
MIN_LIQ_SOL=50
SIDE_CAP_LIQ_FRAC=0.02
SIDE_CAP_POOL_FRAC=0.1
MAX_WITHDRAW_SOL=50
DAILY_WITHDRAW_SOL=100
SPREAD_BPS=25
PROFIT_FEE_BPS=300

# ---- holder tiers (token units) ----
TIER1_TOKENS=1000000
TIER2_TOKENS=5000000
TIER3_TOKENS=10000000

# Extra mints to list at startup, comma separated.
SEED_MINTS=

# ---- Hyperliquid route ----
HL_ENABLED=true
# EVM address that earns builder fees (needs >= 100 USDC perps account value on Hyperliquid). Empty = no fee.
HL_BUILDER=
# Tenths of a basis point. 50 = 0.05% per fill. Hyperliquid caps perps at 100.
HL_BUILDER_FEE=50
# Extra links "mint:COIN[:mult]", comma separated. "mint:-" removes a default link.
HL_MAP=
HL_MAX_DIVERGENCE=0.03
HL_SLIPPAGE=0.03
# HL_TESTNET=true points everything at Hyperliquid testnet.

# ---- new pairs ----
PUMP_FEED=true
AUTO_LIST_GRADUATED=true
PRUNE_AFTER_HOURS=24

# ---- pool risk rules ----
SEASON_HOURS=6
YOUNG_HOURS=24
HOLDER_CHECK_HOURS=72
TOP10_MAX=0.3
LIQ_DROP_MAX=0.4

# ---- arena ----
ARENA_ENABLED=true
ARENA_ROUND_MS=300000
ARENA_FEE_BPS=300
ARENA_MAX_BET_SOL=5
ARENA_MIN_LIQ_SOL=5
